def bytes_texto(n):
    if not n or n < 0:
        return ""
    for lim, u in ((1000 ** 3, "GB"), (1000 ** 2, "MB"), (1000, "kB")):
        if n >= lim:
            t = f"{n / lim:.1f} {u}"
            return t if LINGUA == "en" else t.replace(".", ",")
    return f"{n} B"


def simples(t):
    """Lower case without accents, for the search."""
    return "".join(c for c in unicodedata.normalize("NFD", (t or "").casefold()) if unicodedata.category(c) != "Mn")


def livre():
    st = os.statvfs("/")
    return st.f_bavail * st.f_frsize


def comando_ajudante(args):
    if subprocess.run(["sudo", "-n", "true"], capture_output=True).returncode == 0:
        return ["sudo", "-n", AJUDANTE, *args]
    return ["pkexec", AJUDANTE, *args]


def ler_lista(nome):
    try:
        with open(os.path.join(CATEGORIAS, nome + ".list"), encoding="utf-8") as f:
            return [l.strip() for l in f if l.strip() and not l.startswith("#")]
    except OSError:
        return []


def pacotes_com_menu():
    """The installed apt packages that put a program in the menu (a visible .desktop file in /usr/share/applications),
    found with one dpkg query."""
    d = "/usr/share/applications"
    ficheiros = []
    try:
        nomes = sorted(os.listdir(d))
    except OSError:
        return set()
    for f in nomes:
        if not f.endswith(".desktop"):
            continue
        try:
            texto = open(os.path.join(d, f), encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        if "\nNoDisplay=true" in texto or "\nHidden=true" in texto or "\nExec=" not in texto:
            continue
        ficheiros.append(os.path.join(d, f))
    if not ficheiros:
        return set()
    r = subprocess.run(["dpkg-query", "-S", *ficheiros], capture_output=True, text=True, env=dict(os.environ, LC_ALL="C"))
    pacotes = set()
    for linha in r.stdout.splitlines():
        if linha.startswith("diversion by"):
            continue
        donos, sep, _ = linha.rpartition(": /")
        if not sep:
            continue
        for dono in donos.split(", "):
            pacotes.add(dono.split(":")[0].strip())
    return pacotes


def main():
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import GdkPixbuf, GLib, Gtk, Pango

    Gtk.IconTheme.get_default().append_search_path(ICONES_CATEGORIAS)

    def imagem(fonte, tamanho):
        """A Gtk.Image from a file or an icon name, at a fixed size."""
        try:
            if fonte and fonte.startswith("/") and os.path.exists(fonte):
                return Gtk.Image.new_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_scale(fonte, tamanho, tamanho, True))
            if fonte:
                pb = Gtk.IconTheme.get_default().load_icon(fonte, tamanho, Gtk.IconLookupFlags.FORCE_SIZE)
                return Gtk.Image.new_from_pixbuf(pb)
        except Exception:
            pass
        return Gtk.Image.new_from_icon_name("application-x-executable", Gtk.IconSize.DIALOG)

    def rotulo(texto, *, markup=False, classe=None, largura=None, xalign=0):
        l = Gtk.Label(xalign=xalign)
        l.set_line_wrap(True)
        l.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        (l.set_markup if markup else l.set_text)(texto)
        if largura:
            l.set_max_width_chars(largura)
        if classe:
            l.get_style_context().add_class(classe)
        return l

    class Gestor(Gtk.Window):
        def __init__(self, inicio):
            super().__init__(title=T["titulo"])
            self.set_default_size(1040, 740)
            if os.path.exists(ICONE):
                self.set_icon_from_file(ICONE)
            self.inst = None            # mintcommon.installer.Installer, once loaded
            self.inst_erro = None
            self.a_correr = False
            self.historia = []
            self.tarefa = None          # mintcommon task of the general program page open
            self.connect("delete-event", self.ao_fechar)

            cab = Gtk.HeaderBar(show_close_button=True, title=T["titulo"])
            self.set_titlebar(cab)
            self.b_voltar = Gtk.Button.new_from_icon_name("go-previous-symbolic", Gtk.IconSize.BUTTON)
            self.b_voltar.connect("clicked", lambda *_: self.voltar())
            b_inicio = Gtk.Button.new_from_icon_name("go-home-symbolic", Gtk.IconSize.BUTTON)
            b_inicio.connect("clicked", lambda *_: self.mostra_inicio())
            cab.pack_start(self.b_voltar)
            cab.pack_start(b_inicio)
            self.procura = Gtk.SearchEntry(placeholder_text=T["procurar"], width_chars=30)
            self.procura.connect("search-changed", self.ao_procurar)
            cab.pack_end(self.procura)

            caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            self.add(caixa)
            self.pilha = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
            caixa.pack_start(self.pilha, True, True, 0)

            # The operation area (status, progress, details), at the bottom of every page
            op = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=10)
            self.estado = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
            self.barra = Gtk.ProgressBar()
            self.detalhe = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
            self.exp = Gtk.Expander(label=T["detalhes"])
            self.registo = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.CHAR)
            rr = Gtk.ScrolledWindow(min_content_height=120)
            rr.add(self.registo)
            self.exp.add(rr)
            for w in (self.estado, self.barra, self.detalhe, self.exp):
                op.pack_start(w, False, False, 0)
            self.op = op
            caixa.pack_end(op, False, False, 0)
            caixa.pack_end(Gtk.Separator(), False, False, 0)

            self.pagina_inicio()
            self.show_all()
            self.barra.hide()
            self.detalhe.hide()
            self.b_voltar.set_sensitive(False)
            self.carrega_mint()
            if inicio:
                GLib.idle_add(inicio, self)

        # --- Pages and navigation
        def poe_pagina(self, nome, widget, historia=True):
            antiga = self.pilha.get_child_by_name(nome)
            if historia and self.pilha.get_visible_child_name():
                self.historia.append(self.pilha.get_visible_child_name())
            if antiga is not None and antiga is not widget:
                self.pilha.remove(antiga)
            if widget.get_parent() is None:
                self.pilha.add_named(widget, nome)
            widget.show_all()
            self.pilha.set_visible_child_name(nome)
            self.b_voltar.set_sensitive(bool(self.historia))
            self.cancela_tarefa(nome)

        def voltar(self):
            while self.historia:
                nome = self.historia.pop()
                if self.pilha.get_child_by_name(nome) is not None:
                    if nome == "inicio":
                        self.actualiza_inicio()
                    self.pilha.set_visible_child_name(nome)
                    break
            self.b_voltar.set_sensitive(bool(self.historia))
            self.cancela_tarefa(self.pilha.get_visible_child_name())

        def mostra_inicio(self):
            self.historia = []
            self.actualiza_inicio()
            self.pilha.set_visible_child_name("inicio")
            self.b_voltar.set_sensitive(False)
            self.cancela_tarefa("inicio")

        def cancela_tarefa(self, pagina):
            if pagina != "programa" and self.tarefa is not None and not self.a_correr and self.inst is not None:
                try:
                    self.inst.cancel_task(self.tarefa)
                except Exception:
                    pass
                self.tarefa = None

        def rolavel(self, conteudo):
            r = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
            r.add(conteudo)
            return r

        # --- Home page: the amateur radio programs first, then the categories of the other software
        def pagina_inicio(self):
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin=18)
            topo = Gtk.Box(spacing=14)
            if os.path.exists(ICONE):
                topo.pack_start(imagem(ICONE, 64), False, False, 0)
            t = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            t.pack_start(rotulo(f"<span size='xx-large' weight='bold'>{GLib.markup_escape_text(T['radio'])}</span>",
                                markup=True), False, False, 0)
            t.pack_start(rotulo(T["radio_sub"]), False, False, 0)
            topo.pack_start(t, True, True, 0)
            tudo = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            self.b_tudo = Gtk.Button(label=T["b_tudo"])
            self.b_tudo.get_style_context().add_class("suggested-action")
            self.b_tudo.connect("clicked", lambda *_: self.instalar_tudo())
            self.l_livre = Gtk.Label(xalign=1)
            tudo.pack_start(self.b_tudo, False, False, 0)
            tudo.pack_start(self.l_livre, False, False, 0)
            topo.pack_end(tudo, False, False, 0)
            v.pack_start(topo, False, False, 0)

            subs = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=8, column_spacing=6,
                               row_spacing=6, homogeneous=False)
            for chave, nomes in cat.CATEGORIAS:
                b = Gtk.Button(label=cat.texto(nomes))
                b.connect("clicked", lambda _b, c=chave: self.mostra_radio(c))
                subs.add(b)
            b = Gtk.Button(label=T["outros_radio"])
            b.connect("clicked", lambda *_: self.mostra_outros_radio())
            self.b_outros_radio = b
            subs.add(b)
            v.pack_start(subs, False, False, 0)

            self.grelha_radio = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=3,
                                            min_children_per_line=2, column_spacing=10, row_spacing=10, homogeneous=True)
            v.pack_start(self.grelha_radio, False, False, 0)

            v.pack_start(Gtk.Separator(), False, False, 6)
            v.pack_start(rotulo(f"<span size='x-large' weight='bold'>{GLib.markup_escape_text(T['outras'])}</span>",
                                markup=True), False, False, 0)
            self.l_mint = rotulo(T["a_carregar"])
            v.pack_start(self.l_mint, False, False, 0)
            self.grelha_cat = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=4,
                                          min_children_per_line=2, column_spacing=10, row_spacing=10, homogeneous=True)
            self.botoes_cat = []
            for chave, icone, _, _ in GERAIS:
                b = Gtk.Button()
                h = Gtk.Box(spacing=10, margin=6)
                h.pack_start(Gtk.Image.new_from_icon_name(icone, Gtk.IconSize.LARGE_TOOLBAR), False, False, 0)
                h.pack_start(Gtk.Label(label=T["c_" + chave], xalign=0), True, True, 0)
                b.add(h)
                b.connect("clicked", lambda _b, c=chave: self.mostra_geral(c))
                b.set_sensitive(False)
                self.botoes_cat.append(b)
                self.grelha_cat.add(b)
            v.pack_start(self.grelha_cat, False, False, 0)
            self.b_outros_radio.set_sensitive(False)
            self.poe_pagina("inicio", self.rolavel(v), historia=False)
            self.actualiza_inicio()

        def cartao(self, nome, resumo, icone_w, estado, cor, accao):
            b = Gtk.Button(relief=Gtk.ReliefStyle.NONE)
            h = Gtk.Box(spacing=12, margin=6)
            h.pack_start(icone_w, False, False, 0)
            t = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            t.pack_start(rotulo(f"<b>{GLib.markup_escape_text(nome)}</b>", markup=True), False, False, 0)
            r = Gtk.Label(label=resumo, xalign=0, ellipsize=Pango.EllipsizeMode.END)
            r.get_style_context().add_class("dim-label")
            t.pack_start(r, False, False, 0)
            if estado:
                t.pack_start(rotulo(f"<span size='small' foreground='{cor}'>{GLib.markup_escape_text(estado)}</span>",
                                    markup=True), False, False, 0)
            h.pack_start(t, True, True, 0)
            b.add(h)
            b.connect("clicked", lambda *_: accao())
            return b

        def estado_radio(self, p, est):
            if cat.instalado(p, est):
                return T["instalado"], "#2ea043"
            return (T["a_pedido"] if p["a_pedido"] else T["por_instalar"]), "#8b949e"

        def actualiza_inicio(self):
            for f in self.grelha_radio.get_children():
                self.grelha_radio.remove(f)
            est = cat.pacotes_estado(sorted({x for p in cat.PROGRAMAS for x in cat.pacotes_de(p)}))
            for p in sorted(cat.PROGRAMAS, key=lambda p: p["nome"].casefold()):
                e, cor = self.estado_radio(p, est)
                self.grelha_radio.add(self.cartao(p["nome"], cat.texto(p["resumo"]), imagem(cat.icone(p), 48), e, cor,
                                                  lambda p=p: self.mostra_programa(p["chave"])))
            falta = cat.a_pedido_por_instalar()
            mb = sum(cat.TAMANHOS_MB.get(k, 0) for k in falta)
            self.b_tudo.set_sensitive(bool(falta) and not self.a_correr)
            self.b_tudo.set_tooltip_text(T["d_tudo"].format(n=len(falta), t=bytes_texto(mb * 1000 ** 2)) if falta
                                         else T["tudo_feito"])
            self.l_livre.set_markup(f"<small>{GLib.markup_escape_text(T['livre'].format(t=bytes_texto(livre())))}</small>")
            self.grelha_radio.show_all()

        # --- Lists (a radio sub-category, a category of the other software, search results)
        def pagina_lista(self, titulo, entradas, subtitulo=""):
            """entradas: list of ("radio", program) or ("geral", pkginfo). Rows are added a few at a time, so that a
            big category (thousands of packages) does not freeze the window."""
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=18)
            v.pack_start(rotulo(f"<span size='x-large' weight='bold'>{GLib.markup_escape_text(titulo)}</span>",
                                markup=True), False, False, 0)
            if subtitulo:
                v.pack_start(rotulo(subtitulo, classe="dim-label"), False, False, 0)
            lista = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            lista.get_style_context().add_class("frame")
            v.pack_start(lista, False, False, 0)
            if not entradas:
                v.pack_start(rotulo(T["sem_resultados"]), False, False, 0)
            est = cat.pacotes_estado(sorted({x for k, p in entradas if k == "radio" for x in cat.pacotes_de(p)}))
            pendentes = list(entradas)

            def mais():
                if lista.get_toplevel() is not self:   # the page was replaced: stop
                    return False
                for _ in range(40):
                    if not pendentes:
                        return False
                    k, p = pendentes.pop(0)
                    if k == "radio":
                        e, cor = self.estado_radio(p, est)
                        w = self.cartao(p["nome"], cat.texto(p["resumo"]), imagem(cat.icone(p), 32), e, cor,
                                        lambda p=p: self.mostra_programa(p["chave"]))
                    else:
                        instalado = self.inst.pkginfo_is_installed(p)
                        e, cor = (T["instalado"], "#2ea043") if instalado else ("", "")
                        icone = p.get_icon(32, None) if p.pkg_hash.startswith("a") else None
                        w = self.cartao(p.get_display_name(), p.get_summary() or "", imagem(icone or p.name, 32), e, cor,
                                        lambda p=p: self.mostra_geral_programa(p))
                    lista.add(w)
                    w.show_all()
                return True
            GLib.idle_add(mais)
            return self.rolavel(v)

        def mostra_radio(self, categoria):
            nome = cat.texto(dict(cat.CATEGORIAS)[categoria])
            entradas = [("radio", p) for p in sorted(cat.PROGRAMAS, key=lambda p: p["nome"].casefold())
                        if p["categoria"] == categoria]
            self.poe_pagina("lista", self.pagina_lista(nome, entradas, T["radio"]))

        def mostra_outros_radio(self):
            """The packages of the Debian "hamradio" section that are not in the LogBeamOS catalogue (the Mint Software
            Manager has no category for them)."""
            if self.inst is None:
                return
            nossos = {x for p in cat.PROGRAMAS for x in cat.pacotes_de(p)}
            hashes = self.inst.cache.sections.get("hamradio", [])
            pk = [self.inst.cache[h] for h in hashes if h in self.inst.cache]
            pk = sorted((p for p in pk if p.name not in nossos), key=lambda p: p.get_display_name().casefold())
            self.poe_pagina("lista", self.pagina_lista(T["outros_radio"], [("geral", p) for p in pk], T["radio"]))

        def mostra_geral(self, chave):
            if self.inst is None:
                return
            _, _, listas, seccoes = next(g for g in GERAIS if g[0] == chave)
            c = self.inst.cache
            if chave == "flatpak":
                pk = list(c.get_subset_of_type("f").values())
            elif chave == "instalados":
                self.mostra_instalados()
                return
            else:
                vistos = {}
                for lista in listas:
                    for nome in ler_lista(lista):
                        if nome.startswith("flatpak:"):
                            continue
                        p = self.inst.find_pkginfo(nome, "a")
                        if p is not None:
                            vistos[p.pkg_hash] = p
                for s in seccoes:
                    for h in c.sections.get(s, []):
                        if h in c:
                            vistos[h] = c[h]
                pk = list(vistos.values())
            pk.sort(key=lambda p: p.get_display_name().casefold())
            self.poe_pagina("lista", self.pagina_lista(T["c_" + chave], [("geral", p) for p in pk],
                                                       T["resultados"].format(n=len(pk))))

        def mostra_instalados(self):
            """The installed programs: the radio programs of the catalogue first, then the other software that has a
            menu entry and the installed flatpaks. Asking the Mint engine about each of the ~40 000 entries of its
            cache, as before, froze the window (1.0.0, author's test on an installed disk)."""
            est = cat.pacotes_estado(sorted({x for p in cat.PROGRAMAS for x in cat.pacotes_de(p)}))
            radio = sorted((p for p in cat.PROGRAMAS if cat.instalado(p, est)), key=lambda p: p["nome"].casefold())
            nossos = {x for p in cat.PROGRAMAS for x in cat.pacotes_de(p)}
            nossos |= {cat._gh(p)[6] for p in cat.PROGRAMAS if p["tipo"] == "github" and cat._gh(p)[5] == "flatpak"}
            gerais = {}
            for nome in pacotes_com_menu() - nossos:
                p = self.inst.find_pkginfo(nome, "a")
                if p is not None:
                    gerais[p.pkg_hash] = p
            for ref in lb.flatpak_refs("app") or ():
                if ref.split("/")[0] in nossos:
                    continue
                p = self.inst.find_pkginfo("app/" + ref, "f")
                if p is not None:
                    gerais[p.pkg_hash] = p
            outros = sorted(gerais.values(), key=lambda p: p.get_display_name().casefold())
            entradas = [("radio", p) for p in radio] + [("geral", p) for p in outros]
            self.poe_pagina("lista", self.pagina_lista(T["c_instalados"], entradas,
                                                       T["resultados"].format(n=len(entradas))))

        def ao_procurar(self, entrada):
            if getattr(self, "_procura_id", None):
                GLib.source_remove(self._procura_id)
            self._procura_id = GLib.timeout_add(350, self.procurar, entrada.get_text())

        def procurar(self, texto):
            self._procura_id = None
            t = simples(texto.strip())
            if len(t) < 2:
                return False
            entradas = []
            for p in cat.PROGRAMAS:
                alvos = [p["nome"], p["chave"]] + list(p["resumo"].values()) + [cat.texto(p["descricao"])]
                if any(t in simples(a) for a in alvos):
                    entradas.append(("radio", p))
            if self.inst is not None:
                nossos = {x for p in cat.PROGRAMAS for x in cat.pacotes_de(p)}
                primeiros, outros = [], []
                for p in self.inst.cache.values():
                    if p.name in nossos:
                        continue
                    nome = simples(p.name) + " " + simples(p.get_display_name())
                    if t in nome:
                        primeiros.append(p)
                    elif t in simples(p.get_summary() or "") or t in simples(" ".join(p.get_keywords() or [])
                                                                              if not isinstance(p.get_keywords(), str)
                                                                              else p.get_keywords()):
                        outros.append(p)
                    if len(primeiros) >= MAX_RESULTADOS:
                        break
                primeiros.sort(key=lambda p: (not simples(p.get_display_name()).startswith(t), len(p.name)))
                entradas += [("geral", p) for p in (primeiros + outros)[:MAX_RESULTADOS]]
            n = len(entradas)
            sub = T["resultados_max"].format(n=n) if n >= MAX_RESULTADOS else \
                (T["resultados1"] if n == 1 else T["resultados"].format(n=n))
            self.poe_pagina("pesquisa", self.pagina_lista(f"“{texto.strip()}”", entradas, sub))
            return False

        # --- The page of one radio program
        def mostra_programa(self, chave, instalar=False, historia=True):
            p = cat.POR_CHAVE[chave]
            est = cat.pacotes_estado(cat.pacotes_de(p))
            inst = cat.instalado(p, est)
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin=24)
            topo = Gtk.Box(spacing=16)
            topo.pack_start(imagem(cat.icone(p), 96), False, False, 0)
            t = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            t.pack_start(rotulo(f"<span size='xx-large' weight='bold'>{GLib.markup_escape_text(p['nome'])}</span>",
                                markup=True), False, False, 0)
            t.pack_start(rotulo(cat.texto(p["resumo"])), False, False, 0)
            botoes = Gtk.Box(spacing=8)
            if p["tipo"] == "logbeamos":
                botoes.pack_start(rotulo(T["parte"], classe="dim-label"), False, False, 0)
            elif inst:
                b = Gtk.Button(label=T["b_remover"])
                b.get_style_context().add_class("destructive-action")
                b.connect("clicked", lambda *_: self.remover(p))
                botoes.pack_start(b, False, False, 0)
            else:
                b = Gtk.Button(label=T["b_instalar"])
                b.get_style_context().add_class("suggested-action")
                b.connect("clicked", lambda *_: self.instalar(p))
                botoes.pack_start(b, False, False, 0)
            if inst:
                b = Gtk.Button(label=T["b_abrir"])
                b.connect("clicked", lambda *_: self.abrir(p))
                botoes.pack_start(b, False, False, 0)
            for b in botoes.get_children():
                if isinstance(b, Gtk.Button):
                    b.set_sensitive(not self.a_correr)
            t.pack_start(botoes, False, False, 6)
            topo.pack_start(t, True, True, 0)
            v.pack_start(topo, False, False, 0)

            g = Gtk.Grid(column_spacing=18, row_spacing=6)
            origem = {"apt": T["o_apt"], "github": T["o_github"], "deb": T["o_deb"], "pipx": T["o_pipx"],
                      "wine": T["o_wine"], "logbeamos": T["o_logbeamos"]}[p["tipo"]]
            if p["tipo"] == "github" and cat._gh(p)[5] == "flatpak":
                origem = T["o_flatpak"].format(r="GitHub")
            linhas = [(T["versao"], cat.versao(p, est) if inst else ""), (T["origem"], origem)]
            mb = cat.TAMANHOS_MB.get(chave)
            if mb:
                linhas.append((T["espaco"], T["cerca"].format(t=bytes_texto(mb * 1000 ** 2))))
            for i, (a, b) in enumerate(linhas):
                if not b:
                    continue
                g.attach(rotulo(f"<b>{GLib.markup_escape_text(a)}</b>", markup=True), 0, i, 1, 1)
                g.attach(rotulo(b), 1, i, 1, 1)
            site = Gtk.LinkButton(uri=p["site"], label=p["site"], xalign=0)
            g.attach(rotulo(f"<b>{GLib.markup_escape_text(T['site'])}</b>", markup=True), 0, len(linhas), 1, 1)
            g.attach(site, 1, len(linhas), 1, 1)
            v.pack_start(g, False, False, 0)
            v.pack_start(rotulo(cat.texto(p["descricao"]), largura=90), False, False, 6)
            if not inst and p["tipo"] not in ("wine", "logbeamos"):
                v.pack_start(rotulo(T["rede"] + " " + T["livre"].format(t=bytes_texto(livre())), classe="dim-label"),
                             False, False, 0)
            self.programa_aberto = chave
            self.poe_pagina("programa", self.rolavel(v), historia=historia)
            if instalar and not inst:
                GLib.idle_add(self.instalar, p)

        def abrir(self, p):
            subprocess.Popen(shlex.split(p["comando"]), start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        # --- Operations on radio programs: the LogBeamOS helper (root) or Wine (as the user)
        def comeca(self, texto):
            self.a_correr = True
            self.estado.set_text(texto)
            self.barra.set_fraction(0)
            self.barra.show()
            self.detalhe.set_text(T["a_preparar"])
            self.detalhe.show()
            self.parte = 0.0
            self.com_progresso = False

            def pulsa():
                if not self.a_correr:
                    return False
                if not self.com_progresso:
                    self.barra.pulse()
                return True
            GLib.timeout_add(150, pulsa)

        def escreve(self, texto):
            b = self.registo.get_buffer()
            b.insert(b.get_end_iter(), texto + "\n")
            self.registo.scroll_to_iter(b.get_end_iter(), 0, False, 0, 0)

        def linha_ajudante(self, t, passos):
            """The progress lines of the helper (the same as in "Update LogBeamOS")."""
            if t.startswith("@passo "):
                self.parte, self.com_progresso = 0.0, False
                self.detalhe.set_text(T["a_preparar"])
            elif t.startswith("@baixar "):
                p = t.split(maxsplit=8)
                if len(p) >= 9:
                    pct, feito, total = float(p[1]), int(p[2]), int(p[3])
                    texto = p[8] if p[8] != "-" else "…"
                    if total > 0 and feito >= 0:
                        texto += f" · {bytes_texto(feito)} / {bytes_texto(total)}"
                    self.detalhe.set_text(texto)
                    self.com_progresso = True
                    self.barra.set_fraction(min(1.0, (self.feitos + 0.6 * pct / 100) / passos))
            elif t.startswith("@instalar "):
                p = t.split(maxsplit=2)
                if len(p) >= 3:
                    self.detalhe.set_text(p[2])
                    self.com_progresso = True
                    self.barra.set_fraction(min(1.0, (self.feitos + 0.6 + 0.4 * float(p[1]) / 100) / passos))
            elif t.startswith("@ok ") or t.startswith("@erro "):
                if t.startswith("@erro "):
                    self.erros += 1
                self.feitos += 1
                self.barra.set_fraction(min(1.0, self.feitos / passos))
                self.escreve(t[1:])
            elif not t.startswith("@"):
                self.escreve(t)

        def corre_ajudante(self, args, texto, depois):
            self.comeca(texto)
            self.erros, self.feitos = 0, 0
            passos = max(1, len(args))

            def trabalho():
                p = subprocess.Popen(comando_ajudante(args), stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
                for l in p.stdout:
                    GLib.idle_add(self.linha_ajudante, l.rstrip(), passos)
                codigo = p.wait()
                GLib.idle_add(self.acaba, codigo, depois)
            threading.Thread(target=trabalho, daemon=True).start()

        def acaba(self, codigo, depois):
            self.a_correr = False
            self.barra.hide()
            self.detalhe.hide()
            if codigo in (126, 127):
                msg = T["recusado"]
            elif codigo or self.erros:
                msg = T["erro"]
                self.exp.set_expanded(True)
            else:
                msg = depois
            self.estado.set_text(msg)
            self.actualiza_inicio()
            # The page of the program shows its new state (the same page: the history stays as it was)
            if self.pilha.get_visible_child_name() == "programa" and getattr(self, "programa_aberto", None):
                self.mostra_programa(self.programa_aberto, historia=False)

        def instalar(self, p):
            if self.a_correr:
                return
            self.programa_aberto = p["chave"]
            if p["tipo"] == "wine":
                return self.instalar_wine(p)
            self.corre_ajudante([f"instalar={p['chave']}"], T["a_instalar"].format(nome=p["nome"]),
                                T["feito_inst"].format(nome=p["nome"]))

        def instalar_tudo(self):
            falta = cat.a_pedido_por_instalar()
            if not falta or self.a_correr:
                return
            self.programa_aberto = None
            nomes = ", ".join(cat.POR_CHAVE[k]["nome"] for k in falta)
            self.corre_ajudante([f"instalar={k}" for k in falta], T["a_instalar"].format(nome=nomes),
                                T["feito_inst"].format(nome=nomes))

        def confirma(self, titulo, texto):
            d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                  buttons=Gtk.ButtonsType.NONE, text=titulo)
            d.format_secondary_text(texto)
            d.add_buttons(T["b_cancelar"], Gtk.ResponseType.CANCEL, T["b_remover"], Gtk.ResponseType.OK)
            d.get_widget_for_response(Gtk.ResponseType.OK).get_style_context().add_class("destructive-action")
            r = d.run()
            d.destroy()
            return r == Gtk.ResponseType.OK

        def remover(self, p):
            if self.a_correr:
                return
            if p["tipo"] == "wine":
                texto = T["rem_wine"]
            elif p["chave"] == "4ham":
                texto = T["rem_normal"] + " " + T["rem_4ham"]
            else:
                texto = T["rem_pedido"] if p["a_pedido"] else T["rem_normal"]
            if not self.confirma(T["confirmar_rem"].format(nome=p["nome"]), texto):
                return
            self.programa_aberto = p["chave"]
            if p["tipo"] == "wine":
                return self.remover_wine(p)
            self.corre_ajudante([f"remover={p['chave']}"], T["a_remover"].format(nome=p["nome"]),
                                T["feito_rem"].format(nome=p["nome"]))

        def wine(self, args, cwd, texto, depois):
            """A Windows program run in the user's Wine prefix (wine-env.sh), waiting until Wine has finished."""
            self.comeca(texto)
            self.erros, self.feitos = 0, 0

            def trabalho():
                cmd = ". " + WINE_ENV + " && cd " + shlex.quote(cwd) + " && wine " + " ".join(shlex.quote(a) for a in args) + \
                      " ; r=$?; wineserver -w; exit $r"
                p = subprocess.Popen(["bash", "-c", cmd], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
                for l in p.stdout:
                    GLib.idle_add(self.escreve, l.rstrip())
                codigo = p.wait()
                GLib.idle_add(self.acaba, codigo, depois)
            threading.Thread(target=trabalho, daemon=True).start()

        def remover_wine(self, p):
            pasta, _, _, desinst = cat.WINE_PROGRAMAS[p["chave"]]
            dir_ = os.path.join(cat.prefixo_wine(), "drive_c", "Program Files (x86)", pasta)
            if desinst is None:   # WIRES-X: an MSI, removed by its product code in the Windows uninstall list
                args = ["uninstaller", "--remove", cat.chave_desinstalar(p["chave"])]
                dir_ = cat.prefixo_wine()
            else:
                args = desinst
            self.wine(args, dir_, T["a_remover"].format(nome=p["nome"]), T["feito_rem"].format(nome=p["nome"]))

        def instalar_wine(self, p):
            if p["chave"] == "wiresx":   # the WIRES-X launcher asks for the Yaesu file and installs it
                subprocess.Popen(["wires-x"], start_new_session=True)
                return
            site, opcoes = cat.WINE_INSTALADORES[p["chave"]]
            d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.INFO,
                                  buttons=Gtk.ButtonsType.NONE, text=p["nome"])
            d.format_secondary_text(T["wine_inst"].format(nome=p["nome"]))
            d.add_buttons(T["b_cancelar"], Gtk.ResponseType.CANCEL, T["b_site"], 1, T["b_ficheiro"], 2)
            while True:
                r = d.run()
                if r == 1:
                    subprocess.Popen(["xdg-open", site], start_new_session=True)
                    continue
                break
            d.destroy()
            if r != 2:
                return
            fc = Gtk.FileChooserDialog(title=T["ficheiro_exe"], transient_for=self, action=Gtk.FileChooserAction.OPEN)
            fc.add_buttons(T["b_cancelar"], Gtk.ResponseType.CANCEL, T["b_instalar"], Gtk.ResponseType.OK)
            filtro = Gtk.FileFilter()
            filtro.add_pattern("*.exe")
            filtro.add_pattern("*.EXE")
            fc.set_filter(filtro)
            # the user's downloads folder, in the session language ("Transferências" in Portuguese, 1.0.0 test)
            transf = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD)
            fc.set_current_folder(transf if transf and os.path.isdir(transf) else os.path.expanduser("~"))
            r = fc.run()
            f = fc.get_filename()
            fc.destroy()
            if r != Gtk.ResponseType.OK or not f:
                return
            self.wine([f, *opcoes], os.path.dirname(f), T["a_instalar"].format(nome=p["nome"]),
                      T["feito_inst"].format(nome=p["nome"]))

        # --- The other software: the Linux Mint engine
        def carrega_mint(self):
            try:
                from mintcommon.installer import installer
                self.instalador = installer
                self.inst = None
                i = installer.Installer()
                i.init(lambda: self.mint_pronto(i))
            except Exception as e:
                self.mint_falhou(e)

        def mint_pronto(self, i):
            self.inst = i
            self.l_mint.hide()
            for b in self.botoes_cat:
                b.set_sensitive(True)
            self.b_outros_radio.set_sensitive(True)
            if getattr(self, "pendente_ficheiro", None):
                self.abre_ficheiro_flatpak(self.pendente_ficheiro)
            if getattr(self, "pendente_pacote", None):
                # an apt package first (the Mint lookup needs the type for a name without "apt:"), then a flatpak
                p = i.find_pkginfo(self.pendente_pacote, "a") or i.find_pkginfo(self.pendente_pacote, "f")
                self.pendente_pacote = None
                if p is not None:
                    self.mostra_geral_programa(p)
            return False

        def mint_falhou(self, e):
            self.inst_erro = e
            self.l_mint.set_text(T["sem_lista"].format(e=e))

        def mostra_geral_programa(self, p, historia=True):
            i = self.inst
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin=24)
            topo = Gtk.Box(spacing=16)
            try:
                icone = p.get_icon(96, i.get_appstream_pkg_for_pkginfo(p)) if not p.pkg_hash.startswith("a") else \
                    p.get_icon(96, None)
            except Exception:
                icone = None
            topo.pack_start(imagem(icone or p.name, 96), False, False, 0)
            t = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            t.pack_start(rotulo(f"<span size='xx-large' weight='bold'>{GLib.markup_escape_text(p.get_display_name())}</span>",
                                markup=True), False, False, 0)
            t.pack_start(rotulo(p.get_summary() or ""), False, False, 0)
            self.g_botoes = Gtk.Box(spacing=8)
            self.g_info = rotulo(T["a_preparar"], classe="dim-label")
            self.g_botoes.pack_start(self.g_info, False, False, 0)
            t.pack_start(self.g_botoes, False, False, 6)
            topo.pack_start(t, True, True, 0)
            v.pack_start(topo, False, False, 0)
            g = Gtk.Grid(column_spacing=18, row_spacing=6)
            remoto = p.remote if not p.pkg_hash.startswith("a") else ""
            versao = self.versao_geral(p)
            linhas = ([(T["versao"], versao)] if versao else []) + \
                [(T["origem"], T["o_flatpak"].format(r=remoto) if remoto else T["o_apt"])]
            for n, (a, b) in enumerate(linhas):
                g.attach(rotulo(f"<b>{GLib.markup_escape_text(a)}</b>", markup=True), 0, n, 1, 1)
                g.attach(rotulo(b), 1, n, 1, 1)
            try:
                url = i.get_homepage_url(p)
            except Exception:
                url = None
            if url:
                g.attach(rotulo(f"<b>{GLib.markup_escape_text(T['site'])}</b>", markup=True), 0, len(linhas), 1, 1)
                g.attach(Gtk.LinkButton(uri=url, label=url, xalign=0), 1, len(linhas), 1, 1)
            v.pack_start(g, False, False, 0)
            try:
                descricao = i.get_description(p) or ""
            except Exception:
                descricao = ""
            v.pack_start(rotulo(descricao, largura=90), False, False, 6)
            self.programa_aberto = None
            self.geral_aberto = p
            self.poe_pagina("programa", self.rolavel(v), historia=historia)
            self.tarefa = None
            # The engine works out whether it is an installation or a removal, and what it implies
            i.select_pkginfo(p, self.geral_pronto, self.geral_erro, self.geral_fim, self.geral_progresso,
                             use_mainloop=True, parent_window=self)

        def versao_geral(self, p):
            """The installed version, or else the one on offer. For a flatpak that is not installed the Mint engine
            raises instead of answering None, and the page never opened (1.0.0, author's test): ask it only for an
            installed one."""
            i = self.inst
            try:
                if i.pkginfo_is_installed(p):
                    v = i.get_installed_version(p)
                    if v:
                        return v
            except Exception:
                pass
            try:
                return i.get_version(p) or ""
            except Exception:
                return ""

        def geral_pronto(self, tarefa):
            if self.geral_aberto is not tarefa.pkginfo:
                return
            self.tarefa = tarefa
            for w in self.g_botoes.get_children():
                self.g_botoes.remove(w)
            if tarefa.info_ready_status == tarefa.STATUS_FORBIDDEN or self.protegido(tarefa):
                self.g_botoes.pack_start(rotulo(T["parte"], classe="dim-label"), False, False, 0)
            elif tarefa.info_ready_status != tarefa.STATUS_OK:
                self.g_botoes.pack_start(rotulo(T["erro"], classe="dim-label"), False, False, 0)
            else:
                remover = tarefa.type == "remove"
                rot = T["b_remover"] if remover else T["b_instalar"]
                tam = tarefa.freed_size if remover else (tarefa.install_size or tarefa.download_size)
                b = Gtk.Button(label=rot + (f" ({bytes_texto(tam)})" if tam else ""))
                b.get_style_context().add_class("destructive-action" if remover else "suggested-action")
                b.connect("clicked", lambda *_: self.geral_executa(tarefa))
                b.set_sensitive(not self.a_correr)
                self.g_botoes.pack_start(b, False, False, 0)
            if tarefa.type == "remove":
                cmd = self.comando_geral(tarefa.pkginfo)
                if cmd:
                    b = Gtk.Button(label=T["b_abrir"])
                    b.connect("clicked", lambda *_: subprocess.Popen(cmd, start_new_session=True,
                                                                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
                    self.g_botoes.pack_start(b, False, False, 0)
            self.g_botoes.show_all()

        def comando_geral(self, p):
            """How to open an installed program of the other software: its own menu launcher, as the menu does (a
            flatpak with no file given may open no window: "flatpak run io.mpv.Mpv", 1.0.0-1 test), or flatpak run."""
            if not p.pkg_hash.startswith("a"):
                if os.path.exists(f"/var/lib/flatpak/exports/share/applications/{p.name}.desktop"):
                    return ["gtk-launch", p.name]
                return ["flatpak", "run", p.name]
            r = subprocess.run(["dpkg", "-L", p.name], capture_output=True, text=True)
            for f in r.stdout.splitlines():
                if f.startswith("/usr/share/applications/") and f.endswith(".desktop"):
                    try:
                        texto = open(f, encoding="utf-8", errors="replace").read()
                    except OSError:
                        continue
                    if "\nNoDisplay=true" not in texto and "\nExec=" in texto:
                        return ["gtk-launch", os.path.basename(f)[:-len(".desktop")]]
            return None

        def protegido(self, tarefa):
            """An apt removal that would take LogBeamOS itself, the desktop or Wine is refused (the Mint engine only
            refuses the packages of priority "required")."""
            if tarefa.type != "remove" or not tarefa.pkginfo.pkg_hash.startswith("a"):
                return False
            r = subprocess.run(["apt-get", "-s", "-q", "remove", tarefa.pkginfo.name], capture_output=True, text=True,
                               env=dict(os.environ, LC_ALL="C"))
            sai = {l.split()[1] for l in r.stdout.splitlines() if l.startswith("Remv ")}
            return bool(sai & {"logbeamos-ferramentas", "logbeamos-tqsl", "cinnamon", "cinnamon-core", "wine-stable",
                               "mint-common", "packagekit", "flatpak", "lightdm", "network-manager"})

        def geral_erro(self, tarefa):
            self.escreve(str(getattr(tarefa, "error_message", "") or ""))
            if self.geral_aberto is tarefa.pkginfo:
                for w in self.g_botoes.get_children():
                    self.g_botoes.remove(w)
                self.g_botoes.pack_start(rotulo(T["erro"], classe="dim-label"), False, False, 0)
                self.g_botoes.show_all()

        def geral_executa(self, tarefa):
            if self.a_correr:
                return
            nome = tarefa.pkginfo.get_display_name()
            if tarefa.type == "remove" and not self.confirma(T["confirmar_rem"].format(nome=nome), ""):
                return
            if not self.inst.confirm_task(tarefa):
                return
            self.geral_texto = (T["feito_rem"] if tarefa.type == "remove" else T["feito_inst"]).format(nome=nome)
            self.comeca((T["a_remover"] if tarefa.type == "remove" else T["a_instalar"]).format(nome=nome))
            self.com_progresso = True
            self.inst.execute_task(tarefa)

        def geral_progresso(self, pkginfo, percent, estimating, status_text=None):
            self.com_progresso = not estimating
            if not estimating:
                self.barra.set_fraction(max(0.0, min(1.0, percent / 100)))
            if status_text:
                self.detalhe.set_text(status_text)

        def geral_fim(self, tarefa):
            erro = getattr(tarefa, "error_message", None)
            if erro:
                self.escreve(str(erro))
            self.erros = 1 if erro else 0
            self.tarefa = None
            self.acaba(1 if erro else 0, getattr(self, "geral_texto", ""))
            if self.pilha.get_visible_child_name() == "programa" and self.geral_aberto is tarefa.pkginfo:
                self.mostra_geral_programa(tarefa.pkginfo, historia=False)

        # --- .flatpakref and .flatpakrepo files (opened from the file manager or the browser)
        def abre_ficheiro_flatpak(self, caminho):
            from gi.repository import Gio
            if self.inst is None:
                self.pendente_ficheiro = caminho
                return
            self.pendente_ficheiro = None
            f = Gio.File.new_for_path(caminho)
            if caminho.endswith(".flatpakrepo"):
                d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                      buttons=Gtk.ButtonsType.OK_CANCEL, text=T["flatpak_repo"])
                d.format_secondary_text(os.path.basename(caminho))
                r = d.run()
                d.destroy()
                if r == Gtk.ResponseType.OK:
                    self.inst.add_remote_from_repo_file(
                        f, lambda nome, erro=None: self.estado.set_text(T["fonte_junta"].format(n=nome) if nome else
                                                                         T["erro"]))
                return
            self.inst.get_pkginfo_from_ref_file(f, lambda p, erro=None: p and self.mostra_geral_programa(p))

        def ao_fechar(self, *_):
            if self.a_correr:
                self.estado.set_text(T["a_correr"])
                return True
            Gtk.main_quit()
            return False

    inicio = None
    args = sys.argv[1:]
    if len(args) >= 2 and args[0] in ("--programa", "--instalar") and args[1] in cat.POR_CHAVE:
        chave, instalar = args[1], args[0] == "--instalar"
        inicio = lambda j: j.mostra_programa(chave, instalar=instalar) and False  # noqa: E731
    elif len(args) >= 2 and args[0] == "--pacote":
        # the page of a program of the other software (apt package or flatpak id), once the Mint engine is loaded
        nome = args[1]
        inicio = lambda j: setattr(j, "pendente_pacote", nome) or (j.inst and j.mint_pronto(j.inst)) and False  # noqa: E731
    elif args and (args[0].endswith(".flatpakref") or args[0].endswith(".flatpakrepo")):
        caminho = os.path.abspath(args[0])
        inicio = lambda j: j.abre_ficheiro_flatpak(caminho) and False  # noqa: E731
    Gestor(inicio)
    Gtk.main()


if __name__ == "__main__":
    if os.geteuid() == 0:
        sys.exit("Abra o Gestor de Programas LogBeamOS como utilizador normal.")
    main()
