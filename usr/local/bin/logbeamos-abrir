# LogBeamOS: launcher of the on-demand programs (1.0.0, author's decision of 22/11/2026). The icon is there whether or
# not the program is installed: installed, it opens; not installed, it asks whether to install it, and the "LogBeamOS
# Programs" manager installs it on the program's page.
# Usage: logbeamos-abrir KEY [arguments of the program]
import os
import shlex
import sys

sys.path.insert(0, "/usr/local/lib/logbeamos/actualizar")
import lb_programas as cat  # noqa: E402

TXT = {
    "pt": ("{nome} não está instalado.", "{resumo}.\n\nQuer instalá-lo agora? Ocupa {t} e é preciso ligação à Internet.",
           "Instalar", "Cancelar"),
    "en": ("{nome} is not installed.", "{resumo}.\n\nInstall it now? It takes {t} and an Internet connection is needed.",
           "Install", "Cancel"),
    "es": ("{nome} no está instalado.", "{resumo}.\n\n¿Instalarlo ahora? Ocupa {t} y hace falta conexión a Internet.",
           "Instalar", "Cancelar"),
    "fr": ("{nome} n'est pas installé.", "{resumo}.\n\nL'installer maintenant ? Il occupe {t} et une connexion à Internet "
           "est nécessaire.", "Installer", "Annuler"),
}
CERCA = {"pt": "cerca de {mb} MB", "en": "about {mb} MB", "es": "unos {mb} MB", "fr": "environ {mb} Mo"}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in cat.POR_CHAVE:
        sys.exit("uso: logbeamos-abrir PROGRAMA [argumentos]")
    p = cat.POR_CHAVE[sys.argv[1]]
    if cat.instalado(p):
        cmd = shlex.split(p["comando"]) + [a for a in sys.argv[2:] if a not in ("%U", "%F", "%u", "%f")]
        os.execvp(cmd[0], cmd)
    lingua = cat.lingua()
    titulo, texto, sim, nao = TXT.get(lingua, TXT["en"])
    t = CERCA.get(lingua, CERCA["en"]).format(mb=cat.TAMANHOS_MB.get(p["chave"], "?"))
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import GdkPixbuf, Gtk
    d = Gtk.MessageDialog(message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                          text=titulo.format(nome=p["nome"]))
    d.set_title(p["nome"])
    d.format_secondary_text(texto.format(resumo=cat.texto(p["resumo"]), t=t))
    try:
        d.set_image(Gtk.Image.new_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_scale(cat.icone(p), 64, 64, True)))
        d.set_icon_from_file(cat.icone(p))
    except Exception:
        pass
    d.add_buttons(nao, Gtk.ResponseType.CANCEL, sim, Gtk.ResponseType.OK)
    d.get_widget_for_response(Gtk.ResponseType.OK).get_style_context().add_class("suggested-action")
    d.set_default_response(Gtk.ResponseType.OK)
    d.show_all()
    r = d.run()
    d.destroy()
    if r == Gtk.ResponseType.OK:
        os.execvp("logbeamos-programas", ["logbeamos-programas", "--instalar", p["chave"]])


if __name__ == "__main__":
    main()
