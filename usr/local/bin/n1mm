# N1MM Logger+ (Windows) through Wine.
# N1MM+ uses the radio the way the user chose in "Radio and Equipment": together with the other programs (through the
# sharing) or alone; alone, the sharing stops while N1MM+ is open and comes back when it closes (see radio-wine.sh).
. /usr/local/lib/logbeamos/wine-env.sh
. /usr/local/lib/logbeamos/equipamento/radio-wine.sh
radio_antes n1mm
# Removed through the "LogBeamOS Programs" manager (1.0.0): the manager opens on its page, to install it again
cd "$WINEPREFIX/drive_c/Program Files (x86)/N1MM Logger+" 2>/dev/null && [ -f N1MMLogger.net.exe ] || {
  radio_depois; exec logbeamos-programas --programa n1mm; }
wine N1MMLogger.net.exe "$@"
r=$?
radio_depois
exit $r
