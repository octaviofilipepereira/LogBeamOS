# LogBeamOS: WIRES-X (Yaesu) through Wine.
# WIRES-X is not shipped with LogBeamOS: the user downloads it from the WIRES-X website of Yaesu (it needs their own
# login) and this launcher installs it into the LogBeamOS Wine prefix and shows which COM port is the HRI-200 or the
# radio (author's decision, 13/11/2026). Checked in the workshop on 14/11/2026 with WIRES-X 2.010 (wx2010en.zip):
# it installs and opens at its "COM port setting" screen. A test with an HRI-200 or a radio in PDN mode is still due.
# Since 0.3.28 it starts WIRES-X with a corrected wininet.dll (see the end of this file).
# Usage: wires-x            install if needed, then open
#        wires-x --instalar FILE.zip   install only (no questions)
. /usr/local/lib/logbeamos/wine-env.sh
. /usr/local/lib/logbeamos/equipamento/radio-wine.sh
DIR="$WINEPREFIX/drive_c/Program Files (x86)/YAESUMUSEN/WIRES-X"
EXE="$DIR/Wires-X.exe"
VISTO="$HOME/.config/logbeamos/wires-x-portas-vistas"

t() {
  case "${LANG%%_*}:$1" in
    pt:intro) echo "O WIRES-X é um programa da Yaesu e não vem com o LogBeamOS.

1. Descarregue o software WIRES-X no site WIRES-X da Yaesu (é preciso entrar com o seu ID).
2. Carregue em \"Escolher o ficheiro\" e indique o ficheiro .zip que descarregou (por exemplo wx2010en.zip).

O LogBeamOS instala-o no Wine e indica a porta da HRI-200 ou do rádio (modo PDN), ligados por USB." ;;
    pt:escolher) echo "Escolher o ficheiro…" ;;
    pt:cancelar) echo "Cancelar" ;;
    pt:ficheiro) echo "Indique o ficheiro do WIRES-X descarregado da Yaesu (.zip)" ;;
    pt:instala) echo "A instalar o WIRES-X no Wine…" ;;
    pt:naoe) echo "Este ficheiro não traz o instalador do WIRES-X (WiresSetup.msi). Indique o ficheiro .zip do software WIRES-X descarregado do site da Yaesu." ;;
    pt:falhou) echo "A instalação do WIRES-X falhou. Tente de novo; se voltar a falhar, descarregue outra vez o ficheiro do site da Yaesu." ;;
    pt:portas) echo "No WIRES-X, no ecrã \"COM port setting\", escolha \"Serial port number specify\" e indique o número da porta da HRI-200 ou do rádio:" ;;
    pt:semportas) echo "Não foi encontrada nenhuma porta USB. Ligue a HRI-200 ou o rádio por USB e abra de novo o WIRES-X." ;;
    es:intro) echo "WIRES-X es un programa de Yaesu y no viene con LogBeamOS.

1. Descargue el software WIRES-X en el sitio WIRES-X de Yaesu (hay que entrar con su ID).
2. Pulse \"Elegir el archivo\" e indique el archivo .zip descargado (por ejemplo wx2010en.zip).

LogBeamOS lo instala en Wine e indica el puerto de la HRI-200 o de la radio (modo PDN), conectadas por USB." ;;
    es:escolher) echo "Elegir el archivo…" ;;
    es:cancelar) echo "Cancelar" ;;
    es:ficheiro) echo "Indique el archivo de WIRES-X descargado de Yaesu (.zip)" ;;
    es:instala) echo "Instalando WIRES-X en Wine…" ;;
    es:naoe) echo "Este archivo no contiene el instalador de WIRES-X (WiresSetup.msi). Indique el archivo .zip del software WIRES-X descargado del sitio de Yaesu." ;;
    es:falhou) echo "La instalación de WIRES-X ha fallado. Inténtelo de nuevo; si vuelve a fallar, descargue otra vez el archivo del sitio de Yaesu." ;;
    es:portas) echo "En WIRES-X, en la pantalla \"COM port setting\", elija \"Serial port number specify\" e indique el número del puerto de la HRI-200 o de la radio:" ;;
    es:semportas) echo "No se ha encontrado ningún puerto USB. Conecte la HRI-200 o la radio por USB y abra de nuevo WIRES-X." ;;
    fr:intro) echo "WIRES-X est un logiciel de Yaesu et n'est pas fourni avec LogBeamOS.

1. Téléchargez le logiciel WIRES-X sur le site WIRES-X de Yaesu (une connexion avec votre ID est nécessaire).
2. Cliquez sur « Choisir le fichier » et indiquez le fichier .zip téléchargé (par exemple wx2010en.zip).

LogBeamOS l'installe dans Wine et indique le port de la HRI-200 ou de la radio (mode PDN), branchées en USB." ;;
    fr:escolher) echo "Choisir le fichier…" ;;
    fr:cancelar) echo "Annuler" ;;
    fr:ficheiro) echo "Indiquez le fichier WIRES-X téléchargé chez Yaesu (.zip)" ;;
    fr:instala) echo "Installation de WIRES-X dans Wine…" ;;
    fr:naoe) echo "Ce fichier ne contient pas l'installateur de WIRES-X (WiresSetup.msi). Indiquez le fichier .zip du logiciel WIRES-X téléchargé sur le site de Yaesu." ;;
    fr:falhou) echo "L'installation de WIRES-X a échoué. Réessayez ; en cas de nouvel échec, téléchargez de nouveau le fichier sur le site de Yaesu." ;;
    fr:portas) echo "Dans WIRES-X, à l'écran « COM port setting », choisissez « Serial port number specify » et indiquez le numéro du port de la HRI-200 ou de la radio :" ;;
    fr:semportas) echo "Aucun port USB trouvé. Branchez la HRI-200 ou la radio en USB et rouvrez WIRES-X." ;;
    *:intro) echo "WIRES-X is Yaesu software and does not come with LogBeamOS.

1. Download the WIRES-X software from the WIRES-X website of Yaesu (you need to log in with your ID).
2. Click \"Choose the file\" and select the downloaded .zip file (for example wx2010en.zip).

LogBeamOS installs it in Wine and shows the port of the HRI-200 or of the radio (PDN mode), connected by USB." ;;
    *:escolher) echo "Choose the file…" ;;
    *:cancelar) echo "Cancel" ;;
    *:ficheiro) echo "Select the WIRES-X file downloaded from Yaesu (.zip)" ;;
    *:instala) echo "Installing WIRES-X in Wine…" ;;
    *:naoe) echo "This file does not contain the WIRES-X installer (WiresSetup.msi). Select the .zip file of the WIRES-X software downloaded from the Yaesu website." ;;
    *:falhou) echo "The WIRES-X installation failed. Try again; if it fails again, download the file from the Yaesu website once more." ;;
    *:portas) echo "In WIRES-X, on the \"COM port setting\" screen, choose \"Serial port number specify\" and enter the port number of the HRI-200 or of the radio:" ;;
    *:semportas) echo "No USB port was found. Connect the HRI-200 or the radio by USB and open WIRES-X again." ;;
  esac
}

# USB serial ports as Wine will number them, with the name the device gives itself. The numbers come from the Wine
# registry that portas_wine (radio-wine.sh) writes, the same COM3, COM4… that "Radio and Equipment" shows. Only when
# the registry could not be written (another Wine program was open) do they come from the links Wine itself made at
# its last start (then the first USB cable is COM33). Up to tools 0.3.21 this read the links that wine-env.sh makes,
# which Wine replaces at every start: the launcher said COM3 while WIRES-X saw the cable on COM33.
portas() {
  local c d n id reg
  reg=$(awk '/^\[Software\\\\Wine\\\\Ports\]/ {p = 1; next} /^\[/ {p = 0} p && /^"COM/' "$WINEPREFIX/system.reg" 2>/dev/null)
  {
    if [ -n "$reg" ]; then
      printf '%s\n' "$reg" | sed -n 's/^"\(COM[0-9]*\)"="\([^"]*\)".*/\1 \2/p'
    else    # Wine's own numbering: COM1 to COM32 are the motherboard ports, the USB cables come after (the COM3… links
            # that wine-env.sh makes are not what Wine uses)
      for c in "$WINEPREFIX"/dosdevices/com*; do
        n=${c##*/com}; case "$n" in ''|*[!0-9]*) continue ;; esac
        [ -L "$c" ] && [ "$n" -ge 33 ] && echo "${c##*/} $(readlink "$c")"
      done
    fi
  } | while read -r n d; do
    [ -e "$d" ] || continue
    case "$d" in /dev/ttyUSB*|/dev/ttyACM*) ;; *) continue ;; esac
    id=""
    for s in /dev/serial/by-id/*; do [ "$(readlink -f "$s")" = "$d" ] && id=" — ${s##*/}"; done
    echo "${n^^} ($d)$id"
  done | sort -V
}

instalar() { # $1 = .zip from Yaesu
  local tmp msi
  tmp=$(mktemp -d) || return 1
  if ! unzip -q -o "$1" -d "$tmp" 2>/dev/null || ! msi=$(find "$tmp" -iname 'WiresSetup.msi' | grep -m1 .); then
    rm -rf "$tmp"; zenity --error --title=WIRES-X --width=440 --text="$(t naoe)" 2>/dev/null; return 2
  fi
  # mshtml off: no question about Wine Gecko. In a new, empty prefix the installer stopped at the Wine Mono question;
  # the LogBeamOS prefix already has .NET 4 and installs without questions (workshop, 14/11/2026)
  WINEDLLOVERRIDES="$WINEDLLOVERRIDES;mshtml=" wine msiexec /i "$msi" /qn > /dev/null 2>&1 &
  local p=$!
  while kill -0 "$p" 2>/dev/null; do sleep 1; echo "#"; done | \
    zenity --progress --pulsate --auto-close --no-cancel --title=WIRES-X --text="$(t instala)" 2>/dev/null
  wait "$p"
  rm -rf "$tmp"
  [ -f "$EXE" ] || { zenity --error --title=WIRES-X --width=440 --text="$(t falhou)" 2>/dev/null; return 1; }
  rm -f "$VISTO"
}

if [ "${1:-}" = --instalar ]; then
  [ -f "${2:-}" ] || exit 2
  instalar "$2"; exit $?
fi

if [ ! -f "$EXE" ]; then
  zenity --question --title=WIRES-X --icon-name=dialog-information --width=480 --text="$(t intro)" \
    --ok-label="$(t escolher)" --cancel-label="$(t cancelar)" 2>/dev/null || exit 0
  f=$(zenity --file-selection --title="$(t ficheiro)" --file-filter="WIRES-X (*.zip) | *.zip *.ZIP" \
        --filename="$(xdg-user-dir DOWNLOAD 2>/dev/null)/" 2>/dev/null) || exit 0
  instalar "$f" || exit 1
fi

# The cables declared to Wine, then which COM port to choose in WIRES-X: shown again whenever the cables changed
# since the user last saw it (the marker keeps the list shown; the empty marker of tools 0.3.21 counts as changed).
# The ports can only be declared with Wine closed: a wineserver left by a program that has just closed, or by the
# WIRES-X installer (with its menu shortcuts still being made), ends by itself within seconds, so wait for it, unless
# one of the programs LogBeamOS runs in this Wine prefix is open (then Wine keeps the numbers it already gave)
if ! pgrep -u "$(id -u)" -f 'N1MMLogger[.]net[.]exe|L4ONG[.]exe|Wires-X[.]exe' > /dev/null; then
  timeout 15 "$(dirname "$(readlink -f "$(command -v wine)")")/wineserver" -w 2>/dev/null
fi
# The Yaesu installer leaves a Windows shortcut (Wires-X.lnk) on the desktop, because the Wine desktop is the user's
# desktop; the LogBeamOS shortcut is already in the radio programs folder, so this one goes (author's decision, 16/11/2026)
rm -f "$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")/Wires-X.lnk"
portas_wine
p=$(portas)
if [ -n "$p" ]; then
  if [ "$p" != "$(cat "$VISTO" 2>/dev/null)" ]; then
    zenity --info --title=WIRES-X --width=480 --text="$(t portas)

$p" 2>/dev/null
    mkdir -p "$(dirname "$VISTO")"; printf '%s' "$p" > "$VISTO"
  fi
elif [ ! -s "$VISTO" ]; then
  zenity --warning --title=WIRES-X --width=440 --text="$(t semportas)" 2>/dev/null
fi

# WIRES-X reads the replies of the Yaesu servers by asking for the headers with an index until the call fails. Wine's
# wininet ignored that index, so WIRES-X never got past its first file and stayed OFFLINE ("Server or ID Not Found." at
# the ID activation; CT7APZ, 20/11/2026). LogBeamOS brings the wininet.dll of Wine 11.0 with that one correction
# (0.3.28; source, patch and build in /usr/share/doc/logbeamos-ferramentas/wininet): copied into the WIRES-X folder and
# loaded as a native DLL by WIRES-X alone. Workshop, 21/11/2026: OFFLINE without it, ONLINE(IPv4) with it
WININET=/usr/local/lib/logbeamos/wires-x/wininet.dll
if [ -f "$WININET" ]; then
  cmp -s "$WININET" "$DIR/wininet.dll" || cp -f "$WININET" "$DIR/wininet.dll" 2>/dev/null || true
  [ -f "$DIR/wininet.dll" ] && WINEDLLOVERRIDES="$WINEDLLOVERRIDES;wininet=n,b"
fi

cd "$DIR" || exit 1
exec wine Wires-X.exe "$@"
