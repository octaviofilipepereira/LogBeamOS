# Log4OM 2 (Windows) through Wine.
# Log4OM uses the radio the way the user chose in "Radio and Equipment": together with the other programs (it attaches
# to the sharing) or alone; alone, the sharing stops while Log4OM is open and comes back when it closes (see
# radio-wine.sh).
. /usr/local/lib/logbeamos/wine-env.sh
. /usr/local/lib/logbeamos/equipamento/radio-wine.sh
radio_antes log4om
cd "$WINEPREFIX/drive_c/Program Files (x86)/IW3HMH/Log4OM NextGen" || { radio_depois; exit 1; }
wine L4ONG.exe "$@"
r=$?
radio_depois
exit $r
