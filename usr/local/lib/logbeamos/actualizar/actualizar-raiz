# LogBeamOS: ajudante do "Actualizar LogBeamOS". Corre como root (pkexec no disco, sudo na pen).
# Recebe só os nomes do que actualizar; endereços, versões e somas vêm de lb_actualizar.
#   sistema        sistema operativo inteiro (os pacotes de rádio ficam retidos, salvo se vier também "radio")
#   radio          todos os pacotes de rádio com versão nova
#   radio=a,b      só estes pacotes de rádio
#   pacotes=a,b    só estes pacotes do sistema (escolhidos na lista)
#   flatpak        "flatpak update" of the system installation (qdmr keeps its own line, from GitHub)
#   not1mm, wsjtx, … programas que não vêm por pacote
#   instalar=KEY   install a program of the catalogue of the "LogBeamOS Programs" manager (lb_programas, 1.0.0)
#   remover=KEY    remove one (its menu entries go with it, except the on-demand ones, which ask to install again)
# The manager calls this helper through programas-raiz (its own polkit action, 1.0.0).
# After "sistema" or "pacotes", on an installed system, the old kernels are removed: the one in use and the newest
# stay (14/11/2026, when the Mint Update Manager left LogBeamOS).
# At the end of every run the LogBeamOS identity (description, GRUB title, installer minimum) is applied again.
# If the apt steps installed a new LogBeamOS tools package, the helper starts again with the new code before the
# other programs (tools 0.3.23).
# Os nomes de pacotes só são aceites se estiverem entre os que o próprio ajudante vê com versão nova.
# Escreve para a janela: "@passo chave", "@ok chave versão", "@erro chave texto", "@reiniciar", "@fim",
#   "@listas pct i n origem" (apt-get update: ficheiro i de n),
#   "@baixar pct feito total velocidade eta i n pacote" (bytes, bytes/s, segundos; -1 = desconhecido),
#   "@instalar pct pacote"; o resto é registo.
import collections
import os
import re
import selectors
import subprocess
import sys
import time

sys.path.insert(0, "/usr/local/lib/logbeamos/actualizar")
import lb_actualizar as lb  # noqa: E402
import lb_programas as cat  # noqa: E402


def diz(*partes):
    print(*partes, flush=True)


def corre(cmd, env=None):
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=env)
    ultima = ""
    for linha in p.stdout:
        linha = linha.rstrip()
        if linha:
            ultima = linha
            diz(linha)
    if p.wait():
        raise RuntimeError(ultima or " ".join(cmd))


UNIDADES = {"B": 1, "kB": 1000, "MB": 1000 ** 2, "GB": 1000 ** 3}


def em_bytes(numero, unidade):
    return int(float(numero.replace(",", "")) * UNIDADES.get(unidade, 1))


def corre_apt(cmd, env, listas=False, tolera=False):
    """apt-get com o canal de estado (APT::Status-Fd): a percentagem da transferência (por bytes) e da instalação.
    O total a descarregar vem da linha "Need to get" e o pacote em curso das linhas "Get:"; a velocidade é a média
    dos últimos 4 segundos. Com listas=True (apt-get update) diz só o ficheiro i de n e de onde vem.
    With tolera=True it does not raise when apt fails: it returns (exit code, every output line) (0.9.0-1)."""
    todas = []
    ler, escrever = os.pipe()
    p = subprocess.Popen([cmd[0], "-o", f"APT::Status-Fd={escrever}", *cmd[1:]], stdout=subprocess.PIPE,
                         stderr=subprocess.STDOUT, env=env, pass_fds=(escrever,))
    os.close(escrever)
    sel = selectors.DefaultSelector()
    sel.register(p.stdout, selectors.EVENT_READ, "saida")
    sel.register(ler, selectors.EVENT_READ, "estado")
    resto = {"saida": b"", "estado": b""}
    abertos = 2
    total, actual, ultima, enviado = 0, "", "", 0.0
    amostras = collections.deque()

    def linha_saida(l):
        nonlocal total, actual, ultima
        if not l:
            return
        ultima = l
        todas.append(l)
        diz(l)
        m = re.match(r"^Need to get ([\d.,]+) ([kMG]?B)", l)
        if m:
            total = em_bytes(*m.groups())
        if listas:
            m = re.match(r"^Get:\d+ \S+?://([^/\s]+)\S* (.+?) \[", l)
            if m:
                actual = f"{m.group(1)} {m.group(2)}"
        else:
            m = re.match(r"^Get:\d+ \S+ \S+ \S+ (\S+) \S+ \S+ \[", l)
            if m:
                actual = m.group(1)

    def linha_estado(l):
        nonlocal enviado
        partes = l.split(":", 3)
        if len(partes) < 4:
            return
        tipo, item, pct, desc = partes
        agora = time.monotonic()
        try:
            pct = float(pct)
        except ValueError:
            return
        if tipo == "dlstatus" and listas:
            m = re.search(r"(\d+) of (\d+)", desc)
            if m and (agora - enviado >= 0.25 or pct >= 100):
                enviado = agora
                diz(f"@listas {pct:.1f} {m.group(1)} {m.group(2)} {actual or '-'}")
        elif tipo == "dlstatus":
            feito = int(total * pct / 100) if total else -1
            if feito >= 0:
                amostras.append((agora, feito))
                while amostras and agora - amostras[0][0] > 4:
                    amostras.popleft()
            vel = eta = -1
            if len(amostras) > 1 and amostras[-1][0] > amostras[0][0]:
                vel = int((amostras[-1][1] - amostras[0][1]) / (amostras[-1][0] - amostras[0][0]))
                if vel > 0 and total:
                    eta = int((total - feito) / vel)
            m = re.search(r"(\d+) of (\d+)", desc)
            i, n = m.groups() if m else ("0", "0")
            if agora - enviado >= 0.25 or pct >= 100:
                enviado = agora
                diz(f"@baixar {pct:.1f} {feito} {total or -1} {vel} {eta} {i} {n} {actual or '-'}")
        elif tipo == "pmstatus":
            if agora - enviado >= 0.25 or pct >= 100:
                enviado = agora
                diz(f"@instalar {pct:.1f} {item}")

    while abertos:
        for chave, _ in sel.select():
            fonte = chave.fileobj
            dados = os.read(fonte if isinstance(fonte, int) else fonte.fileno(), 65536)
            if not dados:
                sel.unregister(fonte)
                abertos -= 1
                if resto[chave.data]:
                    (linha_saida if chave.data == "saida" else linha_estado)(resto[chave.data].decode("utf-8", "replace").strip())
                continue
            resto[chave.data] += dados
            *linhas, resto[chave.data] = resto[chave.data].split(b"\n")
            for b in linhas:
                l = b.decode("utf-8", "replace").rstrip()
                (linha_saida if chave.data == "saida" else linha_estado)(l)
    os.close(ler)
    codigo = p.wait()
    if tolera:
        return codigo, todas
    if codigo:
        raise RuntimeError(ultima or " ".join(cmd))


ENV = dict(os.environ, DEBIAN_FRONTEND="noninteractive", LC_ALL="C")
OPC = ["-o", "DPkg::Lock::Timeout=120", "-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold"]
FONTES = []
LISTAS_ACTUALIZADAS = False


def apt_update():
    """Uma só vez por execução, mesmo que se peçam o sistema e os pacotes de rádio."""
    global FONTES, LISTAS_ACTUALIZADAS
    if LISTAS_ACTUALIZADAS:
        return
    FONTES = lb.apt_fontes("/run/logbeamos-actualizar")
    # A package source that fails (one of another program without its signing key, for example) does not stop the
    # update: apt keeps using the other sources, and the one that failed is named in the details (0.9.0-1; until 0.9.0
    # the whole step failed, as the window did: Google Earth on the computer of Bráulio Sousa, CT7APZ, 22/11/2026).
    # It stops only when no source answered (no network) or when apt itself failed.
    codigo, todas = corre_apt(["apt-get", "update", "-q", "-o", "DPkg::Lock::Timeout=120", *FONTES], ENV, listas=True,
                              tolera=True)
    ok, falhas = lb.falhas_apt("\n".join(todas))
    for f, m in falhas:
        diz(f"package source failed, left out: {f} — {m}")
    if falhas and not ok:
        raise RuntimeError("no package source answered: no Internet connection")
    if codigo and not falhas:
        erros = [l for l in todas if l.startswith("E: ")] or todas
        raise RuntimeError(erros[-1] if erros else "apt-get update")
    LISTAS_ACTUALIZADAS = True


def com_versao_nova():
    """Pacotes que o apt actualizaria agora (o ajudante não confia na lista que vem da janela)."""
    r = subprocess.run(["apt-get", "-s", "-q", *FONTES, "dist-upgrade"], capture_output=True, text=True, env=ENV)
    return [m.group(1) for m in (re.match(r"^Inst (\S+) \[", l) for l in r.stdout.splitlines()) if m]


def retem(padroes):
    """Retém, só durante a actualização, os pacotes instalados que correspondem aos padrões.
    Devolve os que reteve, para os soltar no fim (os que já estavam retidos, como o Wine, ficam como estavam)."""
    if not padroes:
        return []
    r = subprocess.run(["dpkg-query", "-W", "-f=${Package} ${Status}\n", *padroes], capture_output=True, text=True)
    instalados = [l.split()[0] for l in r.stdout.splitlines() if l.endswith(" installed")]
    ja = set(subprocess.run(["apt-mark", "showhold"], capture_output=True, text=True).stdout.split())
    novos = [p for p in instalados if p not in ja]
    if novos:
        subprocess.run(["apt-mark", "hold", *novos], check=True, stdout=subprocess.DEVNULL)
    return novos


def solta(retidos):
    if retidos:
        subprocess.run(["apt-mark", "unhold", *retidos], stdout=subprocess.DEVNULL)


def fixos():
    """Na pen o arranque vem sempre da imagem: kernel, GRUB e shim não se actualizam (o GRUB poderia mexer
    no disco do PC)."""
    return list(lb.PEN_FIXOS) if lb.na_pen() else []


def sistema(com_radio):
    """Sistema operativo inteiro. Sem os pacotes de rádio, estes ficam retidos e mantêm a versão que têm."""
    retidos = retem(fixos() + ([] if com_radio else list(lb.PACOTES_RADIO)))
    try:
        apt_update()
        corre_apt(["apt-get", "-y", "-q", *OPC, *FONTES, "dist-upgrade"], ENV)
    finally:
        solta(retidos)
    retira_nucleos_velhos()
    return ""


def retira_nucleos_velhos():
    """Installed system only: the old kernels go away, so that the partition does not fill up with one more kernel
    on each update. A failure here is reported but does not undo the update."""
    try:
        velhos = lb.nucleos_velhos()
        if velhos:
            diz("old kernels to remove: " + " ".join(velhos))
            corre_apt(["apt-get", "-y", "-q", *OPC, *FONTES, "purge", *velhos], ENV)
    except Exception as e:
        diz(f"old kernels not removed: {e}")


def so_estes(pedidos, de_radio):
    """Só os pacotes pedidos (de rádio ou do sistema) que têm de facto versão nova; o apt traz apenas as
    dependências de que precisarem."""
    apt_update()
    validos = set(com_versao_nova())
    if de_radio:
        validos &= set(lb.PACOTES_RADIO)
    else:
        validos -= set(lb.PACOTES_RADIO)
    pend = [p for p in pedidos if p in validos] if pedidos is not None else sorted(validos)
    if lb.na_pen():
        pend = [p for p in pend if not lb.fixo_na_pen(p)]
    if not pend:
        return "0"
    retidos = retem(fixos())
    try:
        corre_apt(["apt-get", "-y", "-q", *OPC, *FONTES, "install", "--only-upgrade", *pend], ENV)
    finally:
        solta(retidos)
    if not de_radio:
        retira_nucleos_velhos()
    return str(len(pend))


def not1mm():
    env = dict(os.environ, **lb.PIPX)
    corre(["pipx", "upgrade", "not1mm"], env)
    corre(["python3", "-I", lb.AJUSTES_NOT1MM])
    corre(["/opt/pipx/venvs/not1mm/bin/python", "-m", "compileall", "-q", "/opt/pipx/venvs/not1mm/lib"])
    return lb.versao_not1mm()


# --- "LogBeamOS Programs" manager (1.0.0): install and remove the programs of the catalogue
# Packages a removal may never take: LogBeamOS itself, the desktop, Wine (N1MM+ and Log4OM) and the manager's engine
NUNCA_REMOVER = {"logbeamos-ferramentas", "logbeamos-tqsl", "cinnamon", "cinnamon-core", "nemo", "lightdm",
                 "xserver-xorg-core", "wine-stable", "mint-common", "packagekit", "flatpak", "python3-gi", "apt", "dpkg",
                 "sudo", "pkexec", "network-manager", "casper"}


def quem_pediu():
    """(uid, gid) of the user who asked (pkexec or sudo), for what is installed in their name (4ham)."""
    import pwd
    uid = int(os.environ.get("PKEXEC_UID") or os.environ.get("SUDO_UID") or 1000)
    try:
        return uid, pwd.getpwuid(uid).pw_gid
    except KeyError:
        return uid, uid


def protege():
    """The packages that programs outside apt use are marked as manually installed, so that the autoremove of a removal
    never takes them (lb_programas.PROTEGIDOS)."""
    instalados = list(cat.pacotes_estado(cat.PROTEGIDOS))
    if instalados:
        subprocess.run(["apt-mark", "manual", *instalados], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def instalar_programa(chave):
    import tempfile
    p = cat.POR_CHAVE[chave]
    if p["tipo"] in ("wine", "logbeamos"):
        raise RuntimeError(f"{chave}: not installed by this helper")
    if cat.instalado(p):
        cat.poe_lancadores(p, diz)
        return cat.versao(p)
    t = p["tipo"]
    retidos = retem(fixos())
    try:
        if t == "apt":
            apt_update()
            corre_apt(["apt-get", "-y", "-q", *OPC, *FONTES, "install", *p["pacotes"]], ENV)
        elif t == "deb":
            with tempfile.TemporaryDirectory(prefix="lb-programas-") as pasta:
                f = cat.descarrega_deb(p, pasta, diz)
                apt_update()
                corre_apt(["apt-get", "-y", "-q", *OPC, *FONTES, "install", f], ENV)
        elif t == "github":
            item = {g[0]: g for g in lb.GITHUB}[p["github"]]
            if item[5] == "fonte":
                cat.instala_4ham_novo(diz, *quem_pediu())
            else:
                if item[5] == "deb":
                    apt_update()   # the .deb may need packages newer than the lists the system has
                lb.instala_github(item, diz)
        elif t == "pipx":
            cat.instala_not1mm(diz)
    finally:
        solta(retidos)
    if not cat.instalado(p):
        raise RuntimeError(f"{chave}: not installed")
    cat.poe_lancadores(p, diz)
    return cat.versao(p)


def remover_programa(chave):
    p = cat.POR_CHAVE[chave]
    if p["tipo"] in ("wine", "logbeamos"):
        raise RuntimeError(f"{chave}: not removed by this helper")
    if not cat.instalado(p):
        cat.tira_lancadores(p, diz)
        return ""
    pacotes = cat.pacotes_de(p)
    if pacotes:
        protege()
        r = subprocess.run(["apt-get", "-s", "-q", "remove", "--autoremove", *pacotes], capture_output=True, text=True,
                           env=ENV)
        sai = [l.split()[1] for l in r.stdout.splitlines() if l.startswith("Remv ")]
        proibidos = sorted(set(sai) & NUNCA_REMOVER)
        if r.returncode or proibidos:
            raise RuntimeError("refused: it would also remove " + (", ".join(proibidos) or r.stderr.strip()[-200:]))
        diz("packages to remove: " + " ".join(sai))
        retidos = retem(fixos())
        try:
            corre_apt(["apt-get", "-y", "-q", *OPC, "remove", "--autoremove", *pacotes], ENV)
        finally:
            solta(retidos)
    elif p["tipo"] == "github":
        cat.remove_github(p, diz)
    elif p["tipo"] == "pipx":
        cat.remove_not1mm(diz)
    if cat.instalado(p):
        raise RuntimeError(f"{chave}: still installed")
    cat.tira_lancadores(p, diz)
    return ""


def purga_mintupdate():
    """The tools package (0.3.17 onwards) conflicts with the Mint Update Manager, so apt removes it, but only removes:
    its configuration files (autostart, sudoers, logrotate) stay until it is purged. Done at the start of every run
    of this helper; not inside the package scripts, where dpkg is busy."""
    # Since 1.0.0 also the Mint Software Manager (Conflicts: mintinstall; the LogBeamOS Software Manager replaces it)
    for pacote, nome in (("mintupdate", "Mint Update Manager"), ("mintinstall", "Mint Software Manager")):
        r = subprocess.run(["dpkg-query", "-W", "-f=${db:Status-Abbrev}", pacote], capture_output=True, text=True)
        if r.stdout.startswith("rc"):
            p = subprocess.run(["dpkg", "--purge", pacote], capture_output=True, text=True,
                               env=dict(os.environ, LC_ALL="C"))
            diz(f"{nome}: configuration files " + ("removed" if p.returncode == 0 else "not removed"))


def identidade():
    """System identity (tools 0.3.18): applied again at the end of every run, because updates of base-files,
    mint-info-cinnamon or ubiquity can put the original text back. On an installed system a new GRUB title also
    needs update-grub; on the pen the boot menu comes from the image and is left alone."""
    try:
        mudou = lb.identidade()
        if mudou:
            diz("system identity: " + ", ".join(mudou))
        if "grub" in mudou and not lb.na_pen() and os.path.exists("/boot/grub/grub.cfg"):
            corre(["update-grub"], dict(os.environ, LC_ALL="C"))
    except Exception as e:
        diz(f"system identity not applied: {e}")


NOME_PACOTE = re.compile(r"^[a-z0-9][a-z0-9+.\-]+(:[a-z0-9]+)?$")


def lista(valor):
    return [p for p in valor.split(",") if NOME_PACOTE.match(p)]


PASSOS_APT = ("sistema", "radio", "pacotes")
RECOMECO = "LOGBEAMOS_ACTUALIZAR_RECOMECO"


def versao_ferramentas():
    r = subprocess.run(["dpkg-query", "-W", "-f=${Version}", "logbeamos-ferramentas"], capture_output=True, text=True)
    return r.stdout.strip()


def recomeca(antes, resto):
    """Tools 0.3.23: when the apt steps of this run installed a new LogBeamOS tools package, this helper starts again
    with the new code (same process, same output to the window) for the steps that are left, so that a fix in the
    programs' installation (such as the Decodium one on the pen) already counts in this run. Only once per run."""
    if not resto or os.environ.get(RECOMECO):
        return
    agora = versao_ferramentas()
    if not agora or agora == antes:
        return
    diz(f"LogBeamOS tools {antes} -> {agora}: the helper starts again with the new code")
    os.execve(sys.executable, [sys.executable, os.path.abspath(sys.argv[0]), *resto], dict(os.environ, **{RECOMECO: "1"}))


def main():
    if os.geteuid() != 0:
        sys.exit("é preciso correr como root")
    purga_mintupdate()
    github = {g[0]: g for g in lb.GITHUB}
    pedidos = []
    for a in sys.argv[1:]:
        chave, _, valor = a.partition("=")
        if chave in ("sistema", "radio", "not1mm", "flatpak", *github) and (not valor or chave == "radio"):
            pedidos.append((chave, lista(valor) if valor else None, a))
        elif chave == "pacotes" and valor:
            pedidos.append((chave, lista(valor), a))
        elif chave in ("instalar", "remover") and valor in cat.POR_CHAVE:
            pedidos.append((f"{chave}:{valor}", None, a))
    chaves = [c for c, _, _ in pedidos]
    antes = versao_ferramentas()
    for i, (c, pacotes, _) in enumerate(pedidos):
        if c not in PASSOS_APT and any(p[0] in PASSOS_APT for p in pedidos[:i]):
            recomeca(antes, [p[2] for p in pedidos[i:]])
        diz(f"@passo {c}")
        try:
            if c == "sistema":
                v = sistema(com_radio="radio" in chaves and {p[0]: p[1] for p in pedidos}["radio"] is None)
            elif c == "radio":
                if "sistema" in chaves and pacotes is None:
                    v = ""  # já foi com o sistema inteiro (dist-upgrade sem reter os pacotes de rádio)
                else:
                    v = so_estes(pacotes, de_radio=True)
            elif c == "pacotes":
                v = so_estes(pacotes, de_radio=False)
            elif c == "not1mm":
                v = not1mm()
            elif c == "flatpak":
                v = lb.actualiza_flatpak("--system", diz)
            elif c.startswith("instalar:"):
                v = instalar_programa(c.split(":", 1)[1])
            elif c.startswith("remover:"):
                v = remover_programa(c.split(":", 1)[1])
            else:
                v = lb.instala_github(github[c], diz)
            diz(f"@ok {c} {v}")
        except Exception as e:  # um programa com problemas não impede os outros
            diz(f"@erro {c} {str(e).splitlines()[-1] if str(e) else type(e).__name__}")
    identidade()
    if os.path.exists("/var/run/reboot-required"):
        diz("@reiniciar")
    diz("@fim")


main()
