<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- LogBeamOS: authorisation for the helper of the "LogBeamOS Programs" manager (1.0.0); the user's password, kept for
     a few minutes, as for "Update LogBeamOS" -->
<policyconfig>
  <vendor>LogBeamOS</vendor>
  <vendor_url>https://logbeam.org</vendor_url>
  <action id="org.logbeamos.programas">
    <description>Install or remove programs</description>
    <description xml:lang="pt">Instalar ou remover programas</description>
    <description xml:lang="es">Instalar o eliminar programas</description>
    <description xml:lang="fr">Installer ou supprimer des logiciels</description>
    <message>Authentication is required to install or remove amateur radio programs</message>
    <message xml:lang="pt">Indique a sua password para instalar ou remover programas de rádio</message>
    <message xml:lang="es">Introduzca su contraseña para instalar o eliminar programas de radio</message>
    <message xml:lang="fr">Saisissez votre mot de passe pour installer ou supprimer des logiciels de radio</message>
    <icon_name>system-software-install</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/logbeamos/programas/programas-raiz</annotate>
  </action>
</policyconfig>
